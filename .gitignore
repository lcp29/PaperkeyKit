# Build directories
# Ignore common build directories generated by CMake or other build systems
build/
cmake-build-*/
out/
bin/

# CMake build artifacts and cache files
# These are generated during the build process and should not be committed
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CMakeScripts/
Testing/
CTestTestfile.cmake
_deps

# Object files and dependencies
# Intermediate files created during compilation
*.o
*.obj
*.o.d
*.d

# Executables
# The final binary output of the project
paperkey
*.exe

# Editor and IDE backup files
# Files created by text editors and IDEs for backup purposes
*~
*.swp
*.swo
*.bak
*.tmp
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific files
# Files specific to operating systems that should not be shared
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Other common files to ignore in C/CMake projects
# Core dumps, logs, and temporary files
core
*.core
*.log
*.pid
*.seed
*.pid.lock
.cache/
*.tgz
*.tar.gz
*.zip